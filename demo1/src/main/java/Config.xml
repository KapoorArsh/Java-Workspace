<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.w3.org/2001/XMLSchema-context"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
http://www.springframework.org/schema/context
http://www.springframework.org/schema/context/spring-context.xsd">
	<bean class="com.spring.student" name="student1">
		<property name="studentid">
			<value>12345</value>
		</property>
		<property name="studentname">
			<value>noorpal</value>
		</property>
		<property name="studentaddress">
			<value>hello</value>
		</property>
	</bean>
	<bean class="com.spring.student" name="student2">
	<property name="studentid" value="67890"/>
	<property name="studentname" value="Ranjha"/>
	<property name="studentaddress" value="Pochinki"/>
	</bean>
	<bean class="com.spring.student" name="student3" 
	p:studentid="34343" p:studentname="Gojo" p:studentaddress="Prison Realm">
	</bean>
</beans>
