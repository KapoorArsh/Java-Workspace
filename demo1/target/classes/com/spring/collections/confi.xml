<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.w3.org/2001/XMLSchema-context"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
http://www.springframework.org/schema/context
http://www.springframework.org/schema/context/spring-context.xsd">
<bean class="com.spring.collections.certi" name="cer">
<constructor-arg value="IOS using Kotlin"/></bean>

	<bean name="emp" class="com.spring.collections.emp">
		<property name="name" value="Ranjha" />
		<property name="phones">
			<list>
				<value>9872613251</value>
				<value>9463821751</value>
				<value>9463200401</value>
			</list>
		</property>
		<property name="addresses">
			<set>
				<value>Delhi</value>
				<value>Mumbai</value>
				<value>Chennai</value>
			</set>
		</property>
		<property name="courses">
			<map>
				<entry key="Networking" value="3 months" />
				<entry key="Cloud Computing" value="4 months" />
				<entry key="PHP" value="2 months" />
			</map>
		</property>
	</bean>
</beans>
