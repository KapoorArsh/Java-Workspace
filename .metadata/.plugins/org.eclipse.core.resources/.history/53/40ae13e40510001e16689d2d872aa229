package oops;
interface printable{
	void print();
	int add();
}
public class Interface implements printable{
	public void print() {
		System.out.print("Hello");
	}
	public int add() {
		for(int i = 0;i<=11;i++) {
			System.out.println("NUMBERSSSSS");
		}
		return i;
	}
	public static void main(String[]args) {
		Interface obj = new Interface();
		obj.print();
		obj.add();
	}
}
