package corejava;

public class functions{
	public void even(){
	for(int i = 2;i <= 10; i++) {
		System.out.println(i);
		++i;
	}
	}
	
	public int perirect(int a,int b) {
		System.out.print("perimeter of rectangle = ");
		return 2*(a+b);
	}
	
	public int rectarea(int k,int l) {
		System.out.print("Area of rectangle = ");
		return k*l;
	}
	
	public int semioarea(int g) {
		System.out.print("Area of semicircle = ");
		return (11*g*g)/7;
	}
	public static void main(String[] args) {
		functions s1 = new functions();
		s1.even();
		functions d1 = new functions();
		System.out.println(d1.perirect(3, 5));
		functions m1 = new functions();
		System.out.println(m1.rectarea(9, 3));
		functions j1 = new functions();
		System.out.println(j1.semioarea(5));
	}
 }