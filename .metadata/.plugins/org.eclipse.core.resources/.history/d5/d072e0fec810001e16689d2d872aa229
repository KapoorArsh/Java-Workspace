package oops;

public class Studentmethodprint {
	int id;
	String name;
	Studentmethodprint(int i,String n){
		id = i;
		name = n;
	}
	void display() {
		System.out.println(id + " " + name);
	}
	public static void main(String []args) {
		Studentmethodprint p1 = new Studentmethodprint(1,"Arsh");
		Studentmethodprint p2 = new Studentmethodprint(2,"Noorpal");
		System.out.println(p1.id + " " + p1.name);
		p1.display();
		p2.display();
	}
}
