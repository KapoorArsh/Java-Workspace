package oops;

public class T2 {
	int id;
	String name;
	String city;
	
	T2(int id,String name,String city){
		this.id = id;
		this.name = name;
		this.city = city;
	}
	public String toString() {
		return id + " " + name + " " + city;
	}
	public static void main(String [] args) {
		T2 d1 = new T2(1,"Noorpal","Ludhiana");
		T2 d2 = new T2(2,"Kartik","Mohali");
		System.out.println(d1);
		System.out.println(d2);
	}
}
