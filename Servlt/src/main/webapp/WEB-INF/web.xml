<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
 <!-- servlet declaration -->
  <servlet>
  <servlet-name>first</servlet-name>
  <servlet-class>src.firstservlet</servlet-class>
  </servlet>
  <servlet>
  <servlet-name>second</servlet-name>
  <servlet-class>src.secondservlet</servlet-class></servlet>
  
  <servlet>
  <servlet-name>first1</servlet-name>
  <servlet-class>src.MyServlet</servlet-class>
  </servlet>
  
  <servlet>
  <servlet-name>form</servlet-name>
  <servlet-class>src.httpserv</servlet-class>
  </servlet>
  <!-- servlet mapping -->
  <servlet-mapping>
  <servlet-name>first</servlet-name>
  <url-pattern>/web</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  <servlet-name>second</servlet-name>
  <url-pattern>/demo</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  <servlet-name>first1</servlet-name>
  <url-pattern>/demo1</url-pattern>
  </servlet-mapping>
   
</web-app>